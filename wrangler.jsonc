{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: serves the Astro build output, no server code.
  "name": "seungjoonlee-blog",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    // Astro writes /articles/foo/index.html; serve it at /articles/foo/.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
