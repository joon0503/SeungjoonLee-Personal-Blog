---
/**
 * A figure with an optional caption.
 *
 *   <Figure src="/figures/lqr/cost.svg" alt="Level sets of the LQR cost" caption="..." />
 *
 * or wrap arbitrary content (an interactive component, an inline SVG, ...):
 *
 *   <Figure caption="Closed-loop trajectories.">
 *     <PhasePortrait />
 *   </Figure>
 */
type Props = {
  caption?: string;
  class?: string;
} & (
  | { src: string; alt: string; width?: number; height?: number }
  | { src?: undefined; alt?: undefined; width?: undefined; height?: undefined }
);

const { src, alt, width, height, caption, class: className } = Astro.props;
const hasCaption = caption !== undefined || Astro.slots.has('caption');
---

<figure class:list={['figure', className]}>
  {src ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /> : <slot />}
  {
    hasCaption && (
      <figcaption>
        <slot name="caption">{caption}</slot>
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 2.25em 0;
  }

  img {
    display: block;
    margin-inline: auto;
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
    text-wrap: pretty;
  }
</style>
