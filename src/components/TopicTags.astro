---
import { topicHref, topicTitle, type TopicId } from '@/lib/topics';

export interface Props {
  topics: readonly TopicId[];
  /** Render as links to topic pages (default) or plain text. */
  linked?: boolean;
}

const { topics, linked = true } = Astro.props;
---

<span class="topics">
  {
    topics.map((t, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        {linked ? <a href={topicHref(t)}>{topicTitle(t)}</a> : <span>{topicTitle(t)}</span>}
      </>
    ))
  }
</span>

<style>
  .topics {
    font-family: var(--sans);
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
