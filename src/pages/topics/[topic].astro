---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import { articlesByTopic, getArticles } from '@/lib/articles';
import { TOPIC_IDS, TOPICS, type TopicId } from '@/lib/topics';

export async function getStaticPaths() {
  const articles = await getArticles();
  // Every registered topic gets a page, even before it has articles.
  return TOPIC_IDS.map((topic) => ({
    params: { topic },
    props: { topic, articles: articlesByTopic(articles, topic) },
  }));
}

interface Props {
  topic: TopicId;
  articles: Awaited<ReturnType<typeof getArticles>>;
}

const { topic, articles } = Astro.props;
const { title, description } = TOPICS[topic];
---

<BaseLayout title={title} description={description}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow"><a href="/topics/">Topics</a></p>
      <h1>{title}</h1>
      <p class="description">{description}</p>
    </header>

    {
      articles.length > 0 ? (
        <ArticleList articles={articles} headingLevel={2} />
      ) : (
        <p class="muted">Nothing here yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
  }

  .description {
    margin: 0.5rem 0 0;
    font-family: var(--body);
    font-size: var(--body-size);
    color: var(--text-muted);
  }
</style>
